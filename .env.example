# ==========================================
# Telegram Dev Bridge - Konfiguratsiya
# ==========================================

# 1. Telegram Bot Token (@BotFather dan olingan)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Xavfsizlik: Botdan foydalanishi mumkin bo'lgan Telegram User ID lar (vergul bilan ajrating)
# O'zingizning ID raqamingizni bilish uchun Telegramda @userinfobot yoki @myidbot ga /start yuboring.
ADMIN_IDS=123456789,987654321

# 2.1 Telegram Hisobni Tozalash (Userbot / Telethon sozlamalari - my.telegram.org dan olinadi)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=


# 3. Boshlang'ich ishchi papka (Bo'sh qoldirilsa, joriy loyiha papkasi olinadi)
# Masalan: C:\Users\parij\Desktop\modul-3\modul_4\tgbot\TelegramDevBridge
DEFAULT_WORKING_DIR=

# 4. Sun'iy intellekt (AI Coding Agent) sozlamalari
# Google Gemini API Key (https://aistudio.google.com/app/apikey manzilidan bepul olinadi)
GEMINI_API_KEY=

# AI Model nomi (Standart: gemini-2.5-flash yoki gemini-1.5-flash)
AI_MODEL=gemini-2.5-flash

# 5. Terminal buyruqlari sozlamalari
# Shell turi: powershell yoki cmd (Windows uchun powershell tavsiya etiladi)
SHELL_TYPE=powershell

# Buyruq bajarilishining maksimal kutish vaqti (soniyalarda)
COMMAND_TIMEOUT=120

# Telegram xabarining maksimal uzunligi (Standart 4000)
MAX_OUTPUT_LENGTH=3800
